    "jsonwebtoken": "9.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.9",
    "@types/node": "22.13.14",
    "prisma": "6.7.0",
    "tsx": "4.19.3",
    "typescript": "5.8.2"
  },
